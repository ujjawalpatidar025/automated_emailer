# Used only for production builds (`npm run build`) — Vite bakes this in at
# build time. Dev keeps using the "/api" + Vite proxy setup in vite.config.js.
#
# Auth is a Bearer token now, not a cookie, so a direct cross-origin call to
# the backend works fine — no same-origin proxying needed, unlike before.
VITE_API_URL=https://automated-emailer-backend.vercel.app/api
