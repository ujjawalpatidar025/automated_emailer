# ─────────────────────────────────────────────────────────────
#  Automator Email — backend environment
#  Copy this file to ".env" and fill in the real values.
# ─────────────────────────────────────────────────────────────

PORT=5000
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# MongoDB connection string (Atlas or local). The database name goes in the
# path, e.g. mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/your_db_name
MONGO_URI=

# Auth secrets. Leave blank and the server generates strong random values on
# first boot and writes them back into this file — nothing to do here unless
# you want to pin them yourself (e.g. across multiple deployments).
JWT_SECRET=
JWT_EXPIRES_IN=30d
# Encrypts each user's Gmail App Password at rest in MongoDB.
CREDENTIAL_ENCRYPTION_KEY=

# ─────────────────────────────────────────────────────────────
#  Sending behaviour / deliverability
# ─────────────────────────────────────────────────────────────
# Delay between each individual email in a batch (milliseconds).
SEND_DELAY_MS=2000
# Hard ceiling on how many emails one "send" request may push.
MAX_BATCH_SIZE=200

# There is no global Gmail config — each user registers with their own Gmail
# address + App Password, which is what campaigns send from once they log in.
