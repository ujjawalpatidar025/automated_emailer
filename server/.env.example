# ─────────────────────────────────────────────────────────────
#  Automator Email — backend environment
#  Copy this file to ".env" and fill in the real values.
# ─────────────────────────────────────────────────────────────

PORT=5000
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# MongoDB connection string (Atlas or local). The database name goes in the
# path, e.g. mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/your_db_name
MONGO_URI=

# Auth secrets. Leave blank and the server generates strong random values on
# first boot and writes them back into this file — nothing to do here unless
# you want to pin them yourself (e.g. across multiple deployments).
JWT_SECRET=
JWT_EXPIRES_IN=30d
# Encrypts each user's Gmail App Password at rest in MongoDB.
CREDENTIAL_ENCRYPTION_KEY=

# Shared secret for GET /api/cron/tick (?key=... or an X-Cron-Secret header).
# Only needed if you're deploying somewhere serverless (Vercel) and want
# scheduled campaigns to actually fire — point an external pinger (e.g.
# cron-job.org) at that URL with this secret every 5-15 minutes. See the
# README's "Scheduling on Vercel" section. Leave blank to disable the route.
CRON_SECRET=

# Resume attachments are stored on Cloudinary (not local disk) so they
# survive Vercel's ephemeral/read-only filesystem. Get these three from
# your Cloudinary dashboard (Settings -> API Keys).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─────────────────────────────────────────────────────────────
#  Sending behaviour / deliverability
# ─────────────────────────────────────────────────────────────
# Hard ceiling on how many emails one "send" request may push.
MAX_BATCH_SIZE=200
# The gap between each individual email is fixed at 5s in code
# (server/src/services/sendService.js's SEND_DELAY_MS), not configurable here.

# There is no global Gmail config — each user registers with their own Gmail
# address + App Password, which is what campaigns send from once they log in.
